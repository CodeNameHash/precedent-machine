{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Precedent Machine Review Queue Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "kind",
    "title",
    "summary",
    "evidence",
    "choices",
    "resolution",
    "resolved_at",
    "resolved_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": ["canonical", "destructive", "unfreeze", "clarify"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "codex_action"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "codex_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resolution": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["choice_key", "label", "codex_action"],
          "properties": {
            "choice_key": { "type": "string" },
            "label": { "type": "string" },
            "codex_action": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "resolved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "resolved_by": {
      "type": ["string", "null"]
    }
  }
}
