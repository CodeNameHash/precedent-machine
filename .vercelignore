/.claude/
/.next/
/.vercel/
/node_modules/
/tests/
/.github/
/scripts/*
!/scripts/ingest-qa.js
# ingest-qa.js (whitelisted above) statically requires this module since the
# 2026-07-23 claims-gate change; without it every Vercel build fails with
# module-not-found while local builds pass (the file exists locally).
!/scripts/reprocess
!/scripts/reprocess/rematerialize-claims.js
/reports/
/supabase/
/docs/acks/
# handoffs/, progress/, reports/ and reviews/ moved under docs/archive/ on
# 2026-08-05; the single archive entry replaces their four ignore lines.
/docs/archive/
/docs/audit/
/docs/audits/
/docs/codex-program/
/docs/ingest/
/docs/schema-migration/
/docs/schema-shape/normalized-v1.json
*.md

!HANDOFF.md
!docs/reprocess/moved-or-dropped-cleanup.md
!docs/schema-shape/provision-processing-flow.md
!docs/schema-shape/provision-taxonomy-triple-model.md
