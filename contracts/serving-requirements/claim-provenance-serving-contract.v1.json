      "requirement_id": "WARNING_EXPOSURE_MUST_BE_LOGGED",
      "ruled_by": "Ben",
      "ruling_date": "2026-08-01",
      "statement": "Warning-exposure should be logged so warning fatigue (audit finding B7) becomes measurable rather than assumed.",
