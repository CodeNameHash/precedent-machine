{
  "name": "precedent-machine",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:home-snapshots": "node scripts/generate-home-snapshots.js",
    "generate:query-registry": "node scripts/generate-query-serving-registry.js",
    "generate:codebase-inventory": "node scripts/generate-codebase-inventory.js",
    "start": "next start",
    "test": "node --max-old-space-size=8192 --test \"tests/**/*.test.js\" \"tests/**/*.spec.js\"",
    "test:active": "node --test tests/product-phase-0.test.js tests/product-phase-1.test.js tests/product-phase-2.test.js tests/product-phase-3.test.js tests/product-phase-3-calibration.test.js tests/product-phase-4.test.js tests/product-release-timing.test.js tests/agreement-revision-classifier.test.js tests/canonical-v2-sec-edgar-intake-capture.test.js tests/canonical-v2-sec-html-canonical-text.test.js tests/resolve-source-span.test.js",
    "test:auth": "node --test tests/auth-cookies.test.js tests/auth-credentials.test.js tests/auth-gate.test.js tests/auth-route-enforcement.test.js tests/auth-session.test.js",
    "diagnose:baseline": "node scripts/canonical-v2-baseline-manifest.mjs --check",
    "diagnose:near-miss": "node scripts/stage-2y-registry-near-miss.mjs --check",
    "diagnose:replay-baseline": "node scripts/stage-2y-registry-substrate-replay.mjs --check --baseline evidence/canonical-v2/stage-2y-registry-substrate-head-baseline.json",
    "ingest-qa": "node scripts/ingest-qa.js",
    "eval": "node scripts/eval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.47.12",
    "@vercel/sandbox": "3.2.1",
    "ajv": "^8.17.1",
    "formidable": "^3.5.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "next": "14.2.21",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "yaml": "2.9.0"
  }
}
